AWS_REGION=ca-central-1
APP_NAME=workshop
STAGE=pov                       # pov | dev
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_PROJECT_REF=...
# Only for scripts/bootstrap-owner.ts (contains the DB password):
SUPABASE_DB_URL=
GOOGLE_CLIENT_ID=...
# Secrets are typed once into scripts/put-secrets.ts, which stores them as SSM SecureString parameters:
#   /workshop/<stage>/supabase-secret-key
#   /workshop/<stage>/google-client-secret
#   /workshop/<stage>/anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
WEB_EXTRA_ORIGINS=http://localhost:5173
OWNER_EMAIL=
OWNER_NAME=
SHOP_NAME=
SHOP_TIMEZONE=America/Toronto
